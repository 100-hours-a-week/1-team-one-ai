# environment

APP_ENV=

LOG_LEVEL=INFO

LOG_DIR=logs

LOG_FILE_NAME=app.log

METRICS_ENABLED=false


# Server

HOST=0.0.0.0

PORT=8000


# LLM

OPENAI_API_KEY=

GEMINI_API_KEY=

OLLAMA_API_KEY=


# URL

CALLBACK_URL=

EXERCISE_API_URL=

# EXERCISES_PATH=./app/data/exercises.json


# Qdrant
# dev  : QDRANT_URL=http://localhost:6333 (기본값, API key 불필요)
# live : QDRANT_URL=https://xxx.qdrant.io + QDRANT_API_KEY=xxx

QDRANT_URL=http://localhost:6333

QDRANT_API_KEY=

QDRANT_EMBEDDING_MODEL=intfloat/multilingual-e5-small